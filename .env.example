GISTLATTICE_APP_NAME=GistLattice
GISTLATTICE_ENV=development
GISTLATTICE_LLM_FACTORY_PATH=

# Provider adapter examples:
# OPENAI_API_KEY=
# GEMINI_API_KEY= (or GOOGLE_API_KEY=)
# ANTHROPIC_API_KEY=
# GISTLATTICE_OLLAMA_HOST=http://localhost:11434
# GISTLATTICE_OPENAI_CHAT_MODEL=gpt-4.1-mini
# GISTLATTICE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# GISTLATTICE_GEMINI_MODEL=gemini-2.5-flash
# GISTLATTICE_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GISTLATTICE_OLLAMA_MODEL=gemma3
# GISTLATTICE_OLLAMA_EMBEDDING_MODEL=embeddinggemma
# GISTLATTICE_ANTHROPIC_MODEL=claude-sonnet-4-20250514
# GISTLATTICE_ANTHROPIC_EMBEDDINGS_FACTORY_PATH=gistlattice.providers.build_openai_embeddings

# Storage backends:
# memory | qdrant
GISTLATTICE_EPISODIC_BACKEND=qdrant
# memory | neo4j
GISTLATTICE_SEMANTIC_BACKEND=neo4j
# memory | redis
GISTLATTICE_QUEUE_BACKEND=redis

GISTLATTICE_QDRANT_HOST=qdrant
GISTLATTICE_QDRANT_PORT=6333
GISTLATTICE_QDRANT_COLLECTION=user_episodic_stream

GISTLATTICE_NEO4J_URI=bolt://neo4j:7687
GISTLATTICE_NEO4J_USERNAME=neo4j
GISTLATTICE_NEO4J_PASSWORD=password

GISTLATTICE_REDIS_URL=redis://redis:6379/0
GISTLATTICE_REDIS_QUEUE_NAME=memory-consolidation
GISTLATTICE_REDIS_PROCESSING_NAME=memory-consolidation:processing

GISTLATTICE_MEMORY_LIMIT=3
